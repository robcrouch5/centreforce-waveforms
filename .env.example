# Copy this file to .env and adjust as needed.

# --- Database ---
# Local development uses a SQLite file (zero setup). For production, point this
# at a hosted Postgres/MySQL database and change `provider` in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- App ---
# Used for absolute URLs / links in emails etc. later on.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
